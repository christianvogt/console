{
  "name": "@console/dashboard",
  "version": "0.0.0-fixed",
  "description": "OpenShift Dashboard Plugin",
  "private": true,
  "scripts": {
    "coverage": "yarn test --coverage --collectCoverageFrom='[\"packages/dashboard/src/**\",\"!**/__tests__/**\",\"!packages/dashboard/src/test/**\"]'",
    "lint": "yarn --cwd ../.. eslint packages/dashboard",
    "test": "yarn --cwd ../.. test packages/dashboard"
  },
  "dependencies": {
    "@console/dynamic-plugin-sdk": "0.0.0-fixed",
    "@console/plugin-sdk": "0.0.0-fixed",
    "@patternfly/dashboard": "0.0.1",
    "react-grid-layout": "^1.3.0"
  },
  "consolePlugin": {
    "entry": "src/plugin.ts",
    "exposedModules": {
      "DashboardPage": "src/components/DashboardPage",
      "activity-card": "src/cards/activity-card",
      "status-card": "src/cards/status-card",
      "details-card": "src/cards/details-card",
      "utilization-card": "src/cards/utilization-card",
      "inventory-card": "src/cards/inventory-card",
      "pipeline-card": "src/cards/pipeline-card"
    }
  }
}
